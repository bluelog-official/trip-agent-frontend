{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/guide/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/guides/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/seo/guide/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guides",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/guides/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/wallet",
      "destination": "/wallet.html"
    },
    {
      "source": "/promote-store",
      "destination": "/promote-store.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/guide/:path+",
      "destination": "/seo/guide/:path+"
    },
    {
      "source": "/guides/:path+",
      "destination": "/seo/guide/:path+"
    },
    {
      "source": "/((?!sitemap\\.xml$|ads\\.txt$|robots\\.txt$).*)",
      "destination": "/index.html"
    }
  ]
}
